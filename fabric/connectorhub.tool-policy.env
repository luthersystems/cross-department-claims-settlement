# connectorhub denies every MCP tool that is not on the connector's built-in
# allowlist, and the Oracle, MySQL, SharePoint and other connectors here have
# none yet (connectorhub TOOL_FILTER.md).  allow-unlisted is the hub's
# temporary escape hatch for that; the hub logs each tool it lets through.
#
# The make targets load this file only when fabric/connectorhub.env does not
# exist, that is, when every connector runs on its mock.  With real
# credentials the hub keeps its allowlists.
CH_TOOL_POLICY=allow-unlisted
