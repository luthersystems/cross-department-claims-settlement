  "definitions": {
    "CdcsServiceContractSignedBody": {
      "type": "object",
      "properties": {
        "signedBy": {
          "type": "string",
          "title": "Required: email of the signer"
        },
        "requestKey": {
          "type": "string",
          "description": "Optional: the input's request key in the claim flow.  A resend after the\nclaim moved on is refused either way, so it never applies twice."
        }
      },
      "description": "The signed contract arrived (eSignature webhook)."
    },
    "CdcsServicePaymentApprovedBody": {
      "type": "object",
      "properties": {
        "signedBy": {
          "type": "string",
          "title": "Required: email of the approver"
        },
        "requestKey": {
          "type": "string",
          "description": "Optional: the input's request key in the claim flow.  A resend after the\nclaim moved on is refused either way, so it never applies twice."
        }
      },
      "description": "The payment team approved the payment."
    },
    "CdcsServicePaymentStatusBody": {
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "title": "Required"
        },
        "status": {
          "type": "string",
          "title": "Required: approved, rejected or pending"
        },
        "requestKey": {
          "type": "string",
          "description": "Optional: the input's request key in the claim flow.  A resend after the\nclaim moved on is refused either way, so it never applies twice."
        }
      },
      "description": "ABS reports the payment status: approved, rejected or pending.  The claim\nwaits for another status after pending."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "protobufNullValue": {
      "type": "string",
      "enum": [
        "NULL_VALUE"
      ],
      "default": "NULL_VALUE",
      "description": "`NullValue` is a singleton enumeration to represent the null value for the\n`Value` type union.\n\nThe JSON representation for `NullValue` is JSON `null`.\n\n - NULL_VALUE: Null value."
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Claim": {
      "type": "object",
      "properties": {
        "claimId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "waiting, done or failed."
        },
        "step": {
          "type": "string",
          "description": "The step the claim waits at, for example \"contract-signed\"."
        },
        "details": {
          "type": "object",
          "description": "The claim's request with the defaults filled in."
        },
        "result": {
          "type": "object",
          "description": "The summary when state is done, with \"decision\" paid or payment rejected."
        },
        "error": {
          "description": "Why the claim failed, when state is failed."
        }
      },
      "description": "A claim as its flow run reports it."
    },
    "v1ContractSignedResponse": {
      "type": "object",
      "properties": {
        "exception": {
          "$ref": "#/definitions/v1Exception"
        },
        "claim": {
          "$ref": "#/definitions/v1Claim"
        }
      }
    },
    "v1Exception": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "UUID for exception."
        },
        "type": {
          "$ref": "#/definitions/v1ExceptionType",
          "description": "Type of exception."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp for when the exception occurred (RFC3339)."
        },
        "description": {
          "type": "string",
          "description": "Human readable description of exception."
        },
        "exceptionMetadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional metadata about the exception."
        }
      },
      "description": "General message for exceptions."
    },
    "v1ExceptionResponse": {
      "type": "object",
      "properties": {
        "exception": {
          "$ref": "#/definitions/v1Exception",
          "description": "An exception if an error occurred during processing request."
        }
      },
      "description": "Exception messages."
    },
    "v1ExceptionType": {
      "type": "string",
      "enum": [
        "INVALID_TYPE",
        "BUSINESS",
        "SERVICE_NOT_AVAILABLE",
        "INFRASTRUCTURE",
        "UNEXPECTED",
        "SECURITY_VIOLATION"
      ],
      "default": "INVALID_TYPE",
      "description": "Type of exception.\n\n - INVALID_TYPE: Default for no exception.\n - BUSINESS: Business logic error.\n - SERVICE_NOT_AVAILABLE: A service was unavailable.\n - INFRASTRUCTURE: Infrastructure was down.\n - UNEXPECTED: Catch-all for all other types.\n - SECURITY_VIOLATION: Security related error."
    },
    "v1GetClaimResponse": {
      "type": "object",
      "properties": {
        "exception": {
          "$ref": "#/definitions/v1Exception"
        },
        "claim": {
          "$ref": "#/definitions/v1Claim"
        }
      }
    },
    "v1PaymentApprovedResponse": {
      "type": "object",
      "properties": {
        "exception": {
          "$ref": "#/definitions/v1Exception"
        },
        "claim": {
          "$ref": "#/definitions/v1Claim"
        }
      }
    },
    "v1PaymentStatusResponse": {
      "type": "object",
      "properties": {
        "exception": {
          "$ref": "#/definitions/v1Exception"
        },
        "claim": {
          "$ref": "#/definitions/v1Claim"
        }
      }
    },
    "v1StartClaimRequest": {
      "type": "object",
      "properties": {
        "policyId": {
          "type": "string",
          "title": "Required"
        },
        "guidewireClaimId": {
          "type": "string",
          "title": "Required"
        },
        "invoiceAmount": {
          "type": "string",
          "title": "Required"
        },
        "signerName": {
          "type": "string",
          "title": "Required: signs the settlement invoice"
        },
        "signerEmail": {
          "type": "string",
          "title": "Required"
        },
        "originatorName": {
          "type": "string",
          "title": "Optional: a demo default if empty"
        },
        "recipientName": {
          "type": "string",
          "title": "Optional: a demo default if empty"
        },
        "issueDate": {
          "type": "string",
          "title": "Optional (YYYY-MM-DD): a demo default if empty"
        },
        "requestKey": {
          "type": "string",
          "description": "Optional: send the same key again to get the same claim back instead of\na second claim.  The portal makes a new key when it is empty."
        },
        "settlementDocumentItemId": {
          "type": "string",
          "description": "Required: the SharePoint item id of the claim's settlement document,\nin the demo document library.  It must not be the ID verification\ndocument.  The ServiceNow incident names this file for review."
        },
        "settlementDocumentFilename": {
          "type": "string",
          "description": "Required: the settlement document's file name.  SharePoint picks the\nparser by its extension (.txt, .pdf, .docx, ...)."
        }
      },
      "description": "Request to start a claim.  The phylum fails the start, and writes\nnothing, when a required field is missing."
    },
    "v1StartClaimResponse": {
      "type": "object",
      "properties": {
        "exception": {
          "$ref": "#/definitions/v1Exception"
        },
        "claim": {
          "$ref": "#/definitions/v1Claim"
        }
      },
      "description": "The responses of the claim RPCs: the claim, or why the call was refused."
    }
  },
  "securityDefinitions": {
    "X-API-KEY": {
      "type": "apiKey",
      "name": "X-API-KEY",
      "in": "header"
    }
  }
}
